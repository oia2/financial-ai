# Пример конфигурации. Реальные значения — в .env рядом с этим файлом.
# .env не коммитится: см. .gitignore.

# Персональный токен Т-Банк Invest с правами ТОЛЬКО НА ЧТЕНИЕ.
# Передаётся исключительно контейнеру backend-worker.
TBANK_INVEST_READ_TOKEN=

# Контур T-Invest API: боевой по умолчанию.
# Песочница: sandbox-invest-public-api.tbank.ru:443
TBANK_INVEST_TARGET=invest-public-api.tbank.ru:443

# PostgreSQL
POSTGRES_USER=financial_ai
POSTGRES_PASSWORD=
POSTGRES_DB=financial_ai

# Порт, на котором доступен интерфейс
FRONTEND_PORT=8080

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Порт PostgreSQL на хосте. Меняется, если 5432 уже занят другим проектом.
POSTGRES_PORT=5432

# Порт эмулятора Daily ML на хосте. Эмулятору не нужны ни секреты, ни БД:
# это единственная его переменная, кроме общего LOG_LEVEL.
DAILY_ML_EMULATOR_PORT=8100

# --- Сбор рыночных данных MOEX -----------------------------------------------
# Данные MOEX ISS публичны: секретов среди этих настроек нет.

MARKET_DATA_ENABLED=true

# Время запуска сбора после закрытия сессии, Europe/Moscow. Собирать раньше
# закрытия нельзя: незавершённая сессия в признаках — утечка будущего.
MARKET_DATA_INGEST_AFTER_CLOSE=19:30

# Начальная дата первичной загрузки. Пусто — вся доступная история.
# Для стенда разумно ограничить, иначе первый прогон займёт часы.
MARKET_DATA_BACKFILL_FROM=

# Глубины окон в ТОРГОВЫХ сессиях. Не выдуманы: выведены из конфигурации
# признаков модели — самое длинное окно признака 252, окно модели 63 (20 у
# позиций), отсюда 252+63-1=314 и 63+20-1=82.
MARKET_DATA_PRICE_WINDOW_SESSIONS=314
MARKET_DATA_GLOBAL_WINDOW_SESSIONS=314
MARKET_DATA_POSITIONS_WINDOW_SESSIONS=82

# Догон пропущенных сессий. Порога по числу пропущенных дней нет: система
# работает с 314 сессиями за раз, и остановка на десятом дне сделала бы механизм
# бесполезным ровно в случае, ради которого он заведён — запуске после простоя.
MARKET_DATA_CATCHUP_ENABLED=true

# Ноль означает «как окно цен»: дыра старше окна набора до модели не доходит.
# Другое значение имеет смысл только для отладки.
MARKET_DATA_CATCHUP_WINDOW_SESSIONS=0

# Наборы неизменяемы и потому накапливаются — срок хранения обязателен.
MARKET_DATA_DATASET_RETENTION_DAYS=30

# Адрес звена ранжирования. Сейчас на этом месте эмулятор.
DAILY_ML_URL=http://daily-ml-emulator:8000
